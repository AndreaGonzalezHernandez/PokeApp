<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadro de mensajes de batalla -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C2410C" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E2A4A" />
            <stroke android:width="2dp" android:color="#F8FAFC" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
