<?xml version="1.0" encoding="utf-8"?>
<!-- Caja de vida estilo juego clásico: blanca con borde oscuro y sombra -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#AA111827" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FAFAF5" />
            <stroke android:width="3dp" android:color="#1F2937" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
