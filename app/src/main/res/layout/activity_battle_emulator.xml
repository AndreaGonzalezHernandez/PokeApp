<?xml version="1.0" encoding="utf-8"?>
<!-- Simulador de batalla: combate automático con estilo pixel-art -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btnBattleBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_box_round_btn"
            android:gravity="center"
            android:text="←"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="BATTLE SIMULATOR"
            android:textColor="#FACC15"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBattleHistory"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="📜 Historial"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ARENA -->
    <FrameLayout
        android:id="@+id/arena"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_versus_arena"
        android:clipChildren="false">

        <!-- Plataformas -->
        <View
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="30dp"
            android:layout_marginTop="150dp"
            android:background="@drawable/bg_versus_platform" />

        <View
            android:layout_width="180dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_versus_platform" />

        <!-- Rival arriba, de frente -->
        <ImageView
            android:id="@+id/ivEnemy"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="35dp"
            android:layout_marginTop="28dp"
            android:contentDescription="Pokémon rival"
            android:scaleType="fitCenter" />

        <!-- Tu Pokémon abajo, de espaldas -->
        <ImageView
            android:id="@+id/ivPlayer"
            android:layout_width="165dp"
            android:layout_height="165dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:contentDescription="Tu Pokémon"
            android:scaleType="fitCenter" />

        <!-- Caja de vida del rival (arriba a la derecha) -->
        <LinearLayout
            android:layout_width="182dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hp_box"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEnemyName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="CHARIZARD"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Lv.100"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:text="HP"
                    android:textColor="#EA580C"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_hp_track"
                    android:padding="1dp">

                    <View
                        android:id="@+id/hpFillEnemy"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hp_fill" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvEnemyHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="--- / ---"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnemyTypes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#6B7280"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Caja de vida nuestra (abajo a la izquierda) -->
        <LinearLayout
            android:layout_width="182dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_hp_box"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="PIKACHU"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Lv.100"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:text="HP"
                    android:textColor="#EA580C"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_hp_track"
                    android:padding="1dp">

                    <View
                        android:id="@+id/hpFillPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hp_fill" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlayerHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="--- / ---"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerTypes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#6B7280"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mensaje de la acción actual -->
    <TextView
        android:id="@+id/tvBattleMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_msg_box"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="Cargando Pokémon..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Movimientos de cada Pokémon (solo informativos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMovesP1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="TÚ"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/gridMovesP1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMovesP2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="RIVAL"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/gridMovesP2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controles: elegir Pokémon + único botón de batalla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChoosePokemon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🗃 Cajas"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStartBattle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_start"
            android:enabled="false"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="▶ INICIAR BATALLA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Registro de batalla -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="REGISTRO DE BATALLA"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_log_box"
        android:minHeight="90dp">

        <TextView
            android:id="@+id/tvBattleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:text=""
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>

    <!-- ===== Pantalla de Resultado (oculta hasta que termina el combate) ===== -->
    <FrameLayout
        android:id="@+id/overlayResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_dim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_result_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="🏆 ¡Victoria!"
                android:textColor="#FACC15"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivWinnerImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Pokémon ganador" />

            <TextView
                android:id="@+id/tvWinnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="PIKACHU"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWinnerStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="HP restante: 42  •  Turnos: 5"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRevancha"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_start"
                android:gravity="center"
                android:text="🔁 Revancha"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnElegirOtro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:text="🗃 Elegir otro Pokémon"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnVerRegistro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:text="📜 Ver registro"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRegresarMenu"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:text="🚪 Regresar al menú"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
