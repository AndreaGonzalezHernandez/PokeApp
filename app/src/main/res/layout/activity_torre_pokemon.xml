<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A202C"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Torre Pokémon"
        android:textColor="#F6E05E"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Supera los 6 niveles para obtener la Medalla de la Torre"
        android:textColor="#A0AEC0"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTowerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel Actual: 1 (Inicio)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbTowerProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="250dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:max="6"
            android:progress="1"
            android:progressTint="#3182CE" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAdvanceTower"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#319795"
        android:text="Combatir Siguiente Nivel"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>