<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de Pokémon con estilo de "Equipo y Cajas" (Pokémon Escarlata/Púrpura) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_box_screen"
    android:orientation="vertical">

    <!-- Barra superior con pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_box_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBoxClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_box_round_btn"
            android:gravity="center"
            android:text="✕"
            android:textColor="#2B3256"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBoxes"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_box_tab_on"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Equipo y Cajas"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabFavs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Favoritos"
            android:textColor="#8D96C2"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Panel de detalle del Pokémon seleccionado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_box_detail"
                android:elevation="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_box_header_yellow"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◓"
                        android:textColor="#2B3256"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvDetailName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Selecciona un Pokémon"
                        android:textColor="#1E2340"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_box_pill_dark"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:text="Lv. 100"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No. ---"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/llDetailTypes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />

                        <ImageView
                            android:id="@+id/imgDetail"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginTop="4dp"
                            android:contentDescription="Pokémon seleccionado"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <com.cesba.pokeapp.StatRadarView
                        android:id="@+id/radarStats"
                        android:layout_width="180dp"
                        android:layout_height="180dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Equipo actual (J1 / J2) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_box_pill_dark"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:text="◉  Equipo actual"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/slotJ1"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box_slot_active"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_box_pill_dark"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="TÚ · Lv. 100"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSlotJ1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgSlotJ1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="Pokémon J1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slotJ2"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box_slot"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_box_pill_dark"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="RIVAL · Lv. 100"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSlotJ2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgSlotJ2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="Pokémon J2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cabecera de la caja: L  [Caja N]  R -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBoxPrev"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_box_lr"
                    android:gravity="center"
                    android:text="L"
                    android:textColor="#2B3256"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBoxName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box_label"
                    android:gravity="center"
                    android:text="Caja 1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBoxNext"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_box_lr"
                    android:gravity="center"
                    android:text="R"
                    android:textColor="#2B3256"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rejilla de la caja (6 x 5) -->
            <GridLayout
                android:id="@+id/gridBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="6" />

            <TextView
                android:id="@+id/tvBoxEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aún no tienes favoritos ⭐"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Búsqueda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etBoxSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box_label"
                    android:hint="Nombre o número"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AEB7E0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnBoxSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_box_label"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="🔍  Buscar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior de controles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_box_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btnBoxAssign"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_box_btn"
            android:gravity="center"
            android:text="Ⓐ Elegir para ti"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBoxConfirm"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_box_btn_yellow"
            android:gravity="center"
            android:text="✓ ¡Listo!"
            android:textColor="#1E2340"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
